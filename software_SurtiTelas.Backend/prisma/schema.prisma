  customer_id   String
  respuestas    Json?
  calificacion  Int?
  comentarios   String?
  completada    Boolean   @default(false)
  completada_at DateTime?
  createdAt     DateTime  @default(now())
  customers     Customer  @relation(fields: [customer_id], references: [id])
  surveys       surveys   @relation(fields: [survey_id], references: [id], onDelete: Cascade)

  @@index([customer_id])
  @@index([survey_id])
}

model surveys {
  id               String             @id
  codigo           String             @unique
  titulo           String
  descripcion      String?
  estado           SurveyStatus       @default(BORRADOR)
  tipo             String
  preguntas        Json?
  custom_order_id  String?            @unique
  created_by_id    String
  createdAt        DateTime           @default(now())
  updatedAt        DateTime
  deleted_at       DateTime?
  survey_responses survey_responses[]
  users            User               @relation(fields: [created_by_id], references: [id])
  custom_orders    custom_orders?     @relation(fields: [custom_order_id], references: [id])

  @@index([deleted_at])
  @@index([estado])
}

model technical_sheet_approvals {
  id                 String           @id
  technical_sheet_id String
  accion             String
  comentario         String?
  usuario_id         String
  createdAt          DateTime         @default(now())
  technical_sheets   technical_sheets @relation(fields: [technical_sheet_id], references: [id], onDelete: Cascade)
  users              User             @relation(fields: [usuario_id], references: [id])

  @@index([technical_sheet_id])
}

model technical_sheet_attachments {
  id                 String           @id
  technical_sheet_id String
  url                String
  nombre             String
  mime_type          String
  tamano             Int
  tipo               String
  uploaded_by_id     String?
  createdAt          DateTime         @default(now())
  technical_sheets   technical_sheets @relation(fields: [technical_sheet_id], references: [id], onDelete: Cascade)
  users              User?            @relation(fields: [uploaded_by_id], references: [id])

  @@index([technical_sheet_id])
}

model technical_sheets {
  id                          String                        @id
  numero                      String                        @unique
  custom_order_id             String
  version                     Int                           @default(1)
  estado                      TechnicalSheetStatus          @default(BORRADOR)
  tipo_prenda                 String
  tecnica_personalizacion     String
  tela_solicitada             String?
  colores_solicitados         String[]                      @default([])
  tallas                      Json?
  cantidad_total              Int
  descripcion_diseno          String?
  referencias                 String[]                      @default([])
  observaciones               String?
  aprobado_por                String?
  aprobado_at                 DateTime?
  rechazado_por               String?
  rechazado_at                DateTime?
  motivo_rechazo              String?
  createdAt                   DateTime                      @default(now())
  updatedAt                   DateTime
  deleted_at                  DateTime?
  canal                       String?
  entregada_en                DateTime?
  enviada_en                  DateTime?
  produccion_iniciada_en      DateTime?
  tiempo_respuesta_horas      Decimal?                      @db.Decimal(10, 2)
  technical_sheet_approvals   technical_sheet_approvals[]
  technical_sheet_attachments technical_sheet_attachments[]
  custom_orders               custom_orders                 @relation(fields: [custom_order_id], references: [id])

  @@index([custom_order_id])
  @@index([deleted_at])
  @@index([estado])
}

model video_calls {
  id              String            @id
  custom_order_id String            @unique
  proveedor       VideoCallProvider
  enlace          String
  codigo_acceso   String?
  contrasena      String?
  fecha_inicio    DateTime?
  fecha_fin       DateTime?
  creado_por_id   String
  createdAt       DateTime          @default(now())
  updatedAt       DateTime
  deleted_at      DateTime?
  users           User              @relation(fields: [creado_por_id], references: [id])
  custom_orders   custom_orders     @relation(fields: [custom_order_id], references: [id])

  @@index([custom_order_id])
  @@index([deleted_at])
}

model Purchase {
  id                String         @id @default(cuid())
  numero            String         @unique
  proveedorId       String         @map("proveedor_id")
  usuarioId         String         @map("usuario_id")
  fecha             DateTime       @default(now())
  total             Decimal        @db.Decimal(12, 2)
  estado            PurchaseStatus @default(PENDIENTE)
  observaciones     String?
  motivoCancelacion String?        @map("motivo_cancelacion")
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  deletedAt         DateTime?      @map("deleted_at")
  items             PurchaseItem[]
  proveedor         Supplier       @relation(fields: [proveedorId], references: [id])
  usuario           User           @relation(fields: [usuarioId], references: [id])

  @@index([proveedorId])
  @@index([usuarioId])
  @@index([estado])
  @@index([deletedAt])
  @@map("purchases")
}

model PurchaseItem {
  id             String       @id @default(cuid())
  purchaseId     String       @map("purchase_id")
  rawMaterialId  String?      @map("raw_material_id")
  nombre         String
  cantidad       Int
  precioUnitario Decimal      @db.Decimal(12, 2)
  subtotal       Decimal      @db.Decimal(12, 2)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?    @map("deleted_at")
  purchase       Purchase     @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  rawMaterial    RawMaterial? @relation(fields: [rawMaterialId], references: [id])

  @@index([purchaseId])
  @@index([rawMaterialId])
  @@map("purchase_items")
}

