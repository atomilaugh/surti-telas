generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                          String                        @id @default(cuid())
  email                       String                        @unique
  passwordHash                String                        @map("password_hash")
  nombre                      String
  telefono                    String?
  direccion                   String?
  tipoDocumento               String?                       @map("tipo_documento")
  numeroDocumento             String?                       @map("numero_documento")
  role                        String
  estado                      EstadoUsuario                 @default(ACTIVO)
  refreshToken                String?                       @map("refresh_token")
  twoFactorEnabled            Boolean                       @default(false) @map("two_factor_enabled")
  twoFactorSecret             String?                       @map("two_factor_secret")
  resetPasswordToken          String?                       @map("reset_password_token")
  resetPasswordExpires        DateTime?                     @map("reset_password_expires")
  failedLoginAttempts         Int                           @default(0) @map("failed_login_attempts")
  lockedUntil                 DateTime?                     @map("locked_until")
  googleId                    String?                       @unique @map("google_id")
  createdAt                   DateTime                      @default(now())
  updatedAt                   DateTime                      @updatedAt
  deletedAt                   DateTime?                     @map("deleted_at")
  apellidos                   String?
  avatar                      String?                       @map("avatar")
  alertsLeidas                Alert[]                       @relation("AlertLeidaPor")
  alertsResueltas             Alert[]                       @relation("AlertResueltaPor")
  auditLogs                   AuditLog[]                    @relation("AuditLogUsuario")
  commissions                 Commission[]                  @relation("AsesorCommissions")
  controlPrendasCreadas       ControlPrenda[]               @relation("ControlPrendaCreadoPor")
  controlPrendasRevisadas     ControlPrenda[]               @relation("ControlPrendaRevisadoPor")
  advisorConversations        Conversation[]                @relation("AdvisorConversations")
  clientConversations         Conversation[]                @relation("ClientConversations")
  custom_order_attachments    custom_order_attachments[]
  customOrderHistory          custom_order_history[]        @relation("CustomOrderHistoryUsuario")
  custom_order_notes          custom_order_notes[]
  custom_orders               custom_orders[]
  customers                   Customer[]                    @relation("AsesorClientes")
  domiciliarioDeliveries      Delivery[]                    @relation("DomiciliarioDeliveries")
  domiciliario                Domiciliario?
  employeeProfile             EmployeeProfile?
  favorites                   Favorite[]
  movements                   InventoryMovement[]           @relation("UsuarioMovements")
  message_templates           message_templates[]
  sentMessages                Message[]
  notifications               Notification[]
  historialPedidos            OrderHistory[]                @relation("OrderHistorialUsuario")
  orders                      Order[]                       @relation("AsesorOrders")
  comprobantesCargados        Order[]                       @relation("OrderComprobanteCargadoPor")
  ordersValidados             Order[]                       @relation("OrderValidadoPor")
  payments                    Payment[]                     @relation("AsesorPayments")
  productions                 ProductionOrder[]             @relation("OperarioProductions")
  purchases                   Purchase[]
  recoveryRequests            RecoveryRequest[]
  surveys                     surveys[]
  technical_sheet_approvals   technical_sheet_approvals[]
  technical_sheet_attachments technical_sheet_attachments[]
  userPermissions             UserPermission[]
  video_calls                 video_calls[]

  @@index([role])
  @@index([deletedAt])
  @@map("users")
}

model Domiciliario {
  id        String   @id @default(cuid())
  userId    String   @unique
  zona      String?
  vehiculo  String?
  capacidad Int?
  activo    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("domiciliarios")
}

model EmployeeProfile {
  id                String        @id @default(cuid())
  userId            String        @unique @map("user_id")
  cargo             String?
  fechaContratacion DateTime?     @map("fecha_contratacion")
  salario           Decimal?      @db.Decimal(12, 2)
  tipoEmpleado      TipoEmpleado? @map("tipo_empleado")
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")
  deletedAt         DateTime?     @map("deleted_at")
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tipoEmpleado])
  @@index([deletedAt])
  @@map("employee_profiles")
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  productId String   @map("product_id")
  createdAt DateTime @default(now()) @map("created_at")
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId])
  @@index([productId])
  @@map("favorites")
}

model Permission {
  id              String           @id @default(cuid())
  code            String           @unique
  description     String
  module          String
  estado          String           @default("ACTIVO")
  createdAt       DateTime         @default(now())
  roles           RolePermission[]
  userPermissions UserPermission[]

  @@map("permissions")
}

model RolePermission {
  role         String     @map("role")
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([role, permissionId])
  @@map("role_permissions")
}

model UserPermission {
  id           String     @id @default(cuid())
  userId       String     @map("user_id")
  permissionId String
  createdAt    DateTime   @default(now())
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, permissionId])
  @@index([userId])
  @@map("user_permissions")
}

model RoleConfig {
  id          String   @id @default(cuid())
  role        String   @unique
  estado      String   @default("ACTIVO")
  descripcion String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("role_configs")
}

model Category {
  id          String     @id @default(cuid())
  nombre      String
  slug        String     @unique
  parentId    String?    @map("parent_id")
  createdAt   DateTime   @default(now())
  descripcion String?
  estado      String     @default("ACTIVO") @map("estado")
  parent      Category?  @relation("Subcategorias", fields: [parentId], references: [id])
  children    Category[] @relation("Subcategorias")
  products    Product[]

  @@map("categories")
}

model Product {
  id               String              @id @default(cuid())
  ref              String              @unique
  codigo           String?
  nombre           String
  descripcion      String?
  descripcionCorta String?             @map("descripcion_corta")
  categoriaId      String?             @map("categoria_id")
  subcategoria     String?
  marca            String?
  precio           Decimal             @db.Decimal(12, 2)
  precioAnterior   Decimal?            @map("precio_anterior") @db.Decimal(12, 2)
  descuento        Int                 @default(0)
  cantidadStock    Int                 @default(0) @map("cantidad_stock")
  stockStatus      StockStatus         @default(OK) @map("stock_status")
  estado           ProductStatus       @default(ACTIVO)
  publicado        Boolean             @default(false)
  fechaPublicacion DateTime?           @map("fecha_publicacion")
  destacado        Boolean             @default(false)
  oferta           Boolean             @default(false)
  nuevo            Boolean             @default(false)
  masVendido       Boolean             @default(false) @map("mas_vendido")
  tela             String
  colores          String[]
  tallas           String[]
  imagenPrincipal  String?             @map("imagen_principal")
  imagenes         String[]            @default([])
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  deletedAt        DateTime?           @map("deleted_at")
  favorites        Favorite[]
  movements        InventoryMovement[]
  orderItems       OrderItem[]
  categoria        Category?           @relation(fields: [categoriaId], references: [id])

  @@index([categoriaId, deletedAt])
  @@index([publicado, estado])
  @@index([stockStatus])
  @@index([stockStatus, publicado])
  @@index([deletedAt])
  @@map("products")
}

model Customer {
  id                String             @id @default(cuid())
  nombre            String
  email             String?            @db.VarChar(255)
  ciudad            String?
  telefono          String?            @map("telefono")
  nit               String?
  asesorId          String?            @map("asesor_id")
  cupoTotal         Decimal            @default(0) @map("cupo_total") @db.Decimal(12, 2)
  cupoUsado         Decimal            @default(0) @map("cupo_usado") @db.Decimal(12, 2)
  deudaVencida      Decimal            @default(0) @map("deuda_vencida") @db.Decimal(12, 2)
  isTrustedCustomer Boolean            @default(false) @map("is_trusted_customer")
  estado            EstadoUsuario      @default(ACTIVO)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  deletedAt         DateTime?          @map("deleted_at")
  apellidos         String?
  direccion         String?
  custom_orders     custom_orders[]
  asesor            User?              @relation("AsesorClientes", fields: [asesorId], references: [id])
  orders            Order[]
  payments          Payment[]
  receipts          Receipt[]
  survey_responses  survey_responses[]

  @@index([asesorId])
  @@index([asesorId, estado])
  @@index([deletedAt])
  @@map("customers")
}

model Order {
  id                           String              @id @default(cuid())
  numero                       String              @unique
  clienteId                    String              @map("cliente_id")
  clienteNombre                String              @map("cliente_nombre")
  asesorId                     String              @map("asesor_id")
  asesorNombre                 String              @map("asesor_nombre")
  tipoFlujo                    String              @default("PRODUCCION") @map("tipo_flujo")
  fecha                        DateTime            @default(now())
  subtotal                     Decimal?            @map("subtotal") @db.Decimal(12, 2)
  impuestos                    Decimal?            @default(0) @map("impuestos") @db.Decimal(12, 2)
  descuentos                   Decimal?            @default(0) @map("descuentos") @db.Decimal(12, 2)
  total                        Decimal             @db.Decimal(12, 2)
  itemsCount                   Int                 @default(0) @map("items_count")
  estado                       OrderStatus         @default(NUEVO)
  prioridad                    OrderPriority       @default(ESTANDAR)
  observaciones                String?
  medioPago                    String?             @map("medio_pago")
  fechaValidacion              DateTime?           @map("fecha_validacion")
  usuarioValidacionId          String?             @map("usuario_validacion_id")
  razonRechazo                 String?             @map("razon_rechazo")
  observacionesRechazo         String?             @map("observaciones_rechazo")
  comprobantePagoUrl           String?             @map("comprobante_pago_url")
  comprobantePagoNombre        String?             @map("comprobante_pago_nombre")
  comprobantePagoMime          String?             @map("comprobante_pago_mime")
  comprobantePagoTamaño       Int?                @map("comprobante_pago_tamaño")
  comprobantePagoCargadoEn     DateTime?           @map("comprobante_pago_cargado_en")
  comprobantePagoCargadoPorId  String?             @map("comprobante_pago_cargado_por_id")
  comprobantePagoEstado        String?             @map("comprobante_pago_estado")
  comprobantePagoObservaciones String?             @map("comprobante_pago_observaciones")
  createdAt                    DateTime            @default(now())
  updatedAt                    DateTime            @updatedAt
  deletedAt                    DateTime?           @map("deleted_at")
  descuentoEspecial            Decimal?            @default(0) @map("descuento_especial") @db.Decimal(5, 2)
  diasCredito                  Int?                @default(0) @map("dias_credito")
  envioGratis                  Boolean?            @default(false) @map("envio_gratis")
  prioridadEnvio               String?             @default("Normal") @map("prioridad_envio")
  motivoAnulacion              String?             @map("motivo_anulacion")
  fechaAnulacion               DateTime?           @map("fecha_anulacion")
  commissions                  Commission[]
  conversationOrders           ConversationOrder[]
  custom_orders                custom_orders?
  deliveries                   Delivery?
  historial                    OrderHistory[]
  items                        OrderItem[]
  asesor                       User                @relation("AsesorOrders", fields: [asesorId], references: [id])
  cliente                      Customer            @relation(fields: [clienteId], references: [id])
  comprobantePagoCargadoPor    User?               @relation("OrderComprobanteCargadoPor", fields: [comprobantePagoCargadoPorId], references: [id])
  usuarioValidacion            User?               @relation("OrderValidadoPor", fields: [usuarioValidacionId], references: [id])
  payments                     Payment[]
  production                   ProductionOrder?
  receipts                     Receipt[]
  returns                      Return[]
  ventas                       Sale[]              @relation("OrderSales")

  @@index([clienteId, deletedAt])
  @@index([asesorId])
  @@index([estado, fecha])
  @@index([estado, fecha, asesorId])
  @@index([tipoFlujo])
  @@index([deletedAt])
  @@map("orders")
}

model OrderItem {
  id                String   @id @default(cuid())
  orderId           String   @map("order_id")
  productId         String?  @map("product_id")
  nombre            String
  precio            Decimal  @db.Decimal(12, 2)
  cantidad          Int
  customOrderItemId String?  @map("custom_order_item_id")
  order             Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product           Product? @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([customOrderItemId])
  @@map("order_items")
}

model Supplier {
  id                String         @id @default(cuid())
  nombre            String
  nit               String         @unique
  telefono          String?
  email             String?
  direccion         String?
  ciudad            String?
  materiales        String[]       @default([])
  estado            SupplierStatus @default(ACTIVO)
  calificacion      Float          @default(0)
  pedidosRealizados Int            @default(0) @map("pedidos_realizados")
  ultimoPedido      DateTime?      @map("ultimo_pedido")
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  deletedAt         DateTime?      @map("deleted_at")
  purchases         Purchase[]
  rawMaterials      RawMaterial[]

  @@index([deletedAt])
  @@map("suppliers")
}

model RawMaterial {
  id             String               @id @default(cuid())
  nombre         String
  categoria      String?
  unidadMedida   String               @map("unidad_medida")
  stockActual    Int                  @default(0) @map("stock_actual")
  stockMinimo    Int                  @default(0) @map("stock_minimo")
  proveedorId    String?              @map("proveedor_id")
  precioUnitario Decimal              @map("precio_unitario") @db.Decimal(12, 2)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  deletedAt      DateTime?            @map("deleted_at")
  categoriaId    String?              @map("categoria_id")
  movements      InventoryMovement[]
  purchaseItems  PurchaseItem[]
  category       RawMaterialCategory? @relation(fields: [categoriaId], references: [id])
  proveedor      Supplier?            @relation(fields: [proveedorId], references: [id])

  @@index([proveedorId])
  @@index([stockActual])
  @@index([categoriaId])
  @@map("raw_materials")
}

model RawMaterialCategory {
  id           String        @id @default(cuid())
  nombre       String
  slug         String        @unique
  descripcion  String?
  estado       String        @default("ACTIVO") @map("estado")
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  deletedAt    DateTime?     @map("deleted_at")
  rawMaterials RawMaterial[]

  @@index([slug])
  @@index([estado])
  @@index([deletedAt])
  @@map("raw_material_categories")
}

model InventoryMovement {
  id            String       @id @default(cuid())
  tipo          MovementType
  productId     String?      @map("product_id")
  rawMaterialId String?      @map("raw_material_id")
  cantidad      Int
  ajuste        Int?
  motivo        String
  usuarioId     String       @map("usuario_id")
  fecha         DateTime     @default(now())
  deletedAt     DateTime?    @map("deleted_at")
  product       Product?     @relation(fields: [productId], references: [id])
  rawMaterial   RawMaterial? @relation(fields: [rawMaterialId], references: [id])
  usuario       User         @relation("UsuarioMovements", fields: [usuarioId], references: [id])

  @@index([productId, fecha])
  @@index([rawMaterialId, fecha])
  @@index([deletedAt])
  @@map("inventory_movements")
}

model Workshop {
  id          String            @id @default(cuid())
  nombre      String
  encargadoId String?           @map("encargado_id")
  direccion   String?
  ciudad      String?
  estado      WorkshopStatus    @default(ACTIVO)
  capacidad   Int?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  deletedAt   DateTime?         @map("deleted_at")
  ocupacion   Int?              @default(0)
  email       String?
  telefono    String?
  productions ProductionOrder[]

  @@map("workshops")
}

model ProductionOrder {
  id              String           @id @default(cuid())
  pedidoId        String?          @unique @map("pedido_id")
  operarioId      String?          @map("operario_id")
  tallerId        String?          @map("taller_id")
  referencia      String
  cantidad        Int
  fechaInicio     DateTime         @default(now()) @map("fecha_inicio")
  fechaEstimada   DateTime         @map("fecha_estimada")
  avance          Int              @default(0)
  estado          ProductionStatus @default(PENDIENTE)
  tela            String?
  colores         String[]
  curvaTallas     Json?            @map("curva_tallas")
  notasTecnicas   String?          @map("notas_tecnicas")
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  deletedAt       DateTime?        @map("deleted_at")
  custom_order_id String?          @unique
  controlPrendas  ControlPrenda[]
  items           ProductionItem[]
  custom_orders   custom_orders?   @relation(fields: [custom_order_id], references: [id])
  operario        User?            @relation("OperarioProductions", fields: [operarioId], references: [id])
  pedido          Order?           @relation(fields: [pedidoId], references: [id])
  taller          Workshop?        @relation(fields: [tallerId], references: [id])

  @@index([pedidoId])
  @@index([estado])
  @@index([deletedAt])
  @@index([custom_order_id])
  @@map("production_orders")
}

model ProductionItem {
  id             String          @id @default(cuid())
  produccionId   String          @map("produccion_id")
  nombre         String
  descripcion    String?
  cantidad       Int
  unidad         String?
  deletedAt      DateTime?       @map("deleted_at")
  createdAt      DateTime        @default(now())
  precioUnitario Float?
  updatedAt      DateTime        @updatedAt
  produccion     ProductionOrder @relation(fields: [produccionId], references: [id], onDelete: Cascade)

  @@index([produccionId])
  @@index([deletedAt])
  @@map("production_items")
}

model Notification {
  id           String           @id @default(cuid())
  tipo         NotificationType
  titulo       String
  mensaje      String
  leida        Boolean          @default(false)
  usuarioId    String?          @map("usuario_id")
  createdAt    DateTime         @default(now())
  deletedAt    DateTime?        @map("deleted_at")
  modulo       String?
  referenciaId String?          @map("referencia_id")
  action       String?
  actorId      String?          @map("actor_id")
  entityId     String?          @map("entity_id")
  entityType   String?          @map("entity_type")
  metadata     Json?
  readAt       DateTime?        @map("read_at")
  targetUserId String?          @map("target_user_id")
  usuario      User?            @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId, leida])
  @@index([deletedAt])
  @@index([modulo, referenciaId])
  @@index([entityType, entityId])
  @@index([actorId])
  @@index([targetUserId])
  @@index([createdAt])
  @@map("notifications")
}

model PushSubscription {
  id         String    @id @default(cuid())
  userId     String    @map("user_id")
  endpoint   String    @unique
  keysP256dh String    @map("keys_p256dh")
  keysAuth   String    @map("keys_auth")
  userAgent  String?
  createdAt  DateTime  @default(now())
  deletedAt  DateTime? @map("deleted_at")

  @@index([userId])
  @@map("push_subscriptions")
}

model WebhookSubscription {
  id        String    @id @default(cuid())
  url       String
  secret    String?
  events    String[]  @default([])
  active    Boolean   @default(true)
  usuarioId String?   @map("usuario_id")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? @map("deleted_at")

  @@index([usuarioId])
  @@index([active])
  @@index([deletedAt])
  @@map("webhook_subscriptions")
}

model Payment {
  id                 String        @id @default(cuid())
  orderId            String        @map("order_id")
  customerId         String        @map("customer_id")
  asesorId           String?       @map("asesor_id")
  amount             Decimal       @db.Decimal(12, 2)
  method             PaymentMethod
  status             PaymentStatus @default(PENDING)
  reference          String?
  notes              String?
  paidAt             DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  deletedAt          DateTime?     @map("deleted_at")
  motivoAnulacion    String?       @map("motivo_anulacion")
  fechaAnulacion     DateTime?     @map("fecha_anulacion")
  comprobantePagoUrl String?       @map("comprobante_pago_url")
  asesor             User?         @relation("AsesorPayments", fields: [asesorId], references: [id])
  customer           Customer      @relation(fields: [customerId], references: [id])
  order              Order         @relation(fields: [orderId], references: [id])

  @@index([orderId])
  @@index([customerId])
  @@index([asesorId])
  @@index([status])
  @@index([deletedAt])
  @@map("payments")
}

model Receipt {
  id               String    @id @default(cuid())
  orderId          String?   @map("order_id")
  customerId       String    @map("customer_id")
  numero           String    @unique
  total            Decimal   @db.Decimal(12, 2)
  concepto         String
  notas            String?
  url              String?
  emitidoPor       String?
  emitidoAt        DateTime  @default(now()) @map("emitido_at")
  estado           String    @default("BORRADOR")
  estadoEnvio      String?   @default("PENDIENTE") @map("estado_envio")
  fechaEnvio       DateTime? @map("fecha_envio")
  intentosEnvio    Int       @default(0) @map("intentos_envio")
  ultimoErrorEnvio String?   @map("ultimo_error_envio")
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime? @map("deleted_at")
  customer         Customer  @relation(fields: [customerId], references: [id])
  order            Order?    @relation(fields: [orderId], references: [id])

  @@index([customerId])
  @@index([orderId])
  @@index([estado])
  @@index([deletedAt])
  @@map("receipts")
}

model Sale {
  id                 String    @id @default(cuid())
  orderId            String    @map("order_id")
  clienteId          String    @map("cliente_id")
  clienteNombre      String    @map("cliente_nombre")
  asesorId           String    @map("asesor_id")
  asesorNombre       String    @map("asesor_nombre")
  fechaVenta         DateTime  @default(now()) @map("fecha_venta")
  subtotal           Decimal   @db.Decimal(12, 2)
  impuestos          Decimal   @db.Decimal(12, 2)
  descuentos         Decimal   @db.Decimal(12, 2)
  total              Decimal   @db.Decimal(12, 2)
  estado             String    @default("COMPLETADA")
  medioPago          String?   @map("medio_pago")
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  deletedAt          DateTime? @map("deleted_at")
  motivoAnulacion    String?   @map("motivo_anulacion")
  paymentId          String?   @unique @map("payment_id")
  tipoPago           String?   @map("tipo_pago")
  numeroCuota        Int?      @map("numero_cuota")
  totalCuotas        Int?      @map("total_cuotas")
  esAnticipo         Boolean?  @default(false) @map("es_anticipo")
  esSaldo            Boolean?  @default(false) @map("es_saldo")
  paymentStatus      String?   @map("payment_status")
  comprobantePagoUrl String?   @map("comprobante_pago_url")
  registradoPorId    String?   @map("registrado_por_id")
